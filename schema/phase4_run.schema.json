{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naveed949/sft-loop/schema/phase4_run.schema.json",
  "title": "phase4 tenk lora report",
  "description": "Sibling of schema/run_report.schema.json. No weight_change_claimed field. Used by phase4.assemble after the Kaggle kernel returns raw outputs. additionalProperties is false.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_kind",
    "task_id",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "phase4-1" },
    "document_kind": { "const": "phase4-tenk-lora" },
    "task_id": { "const": "tenk-extract-v1" },
    "metric_name": { "const": "exact_match" },
    "status": { "type": "string", "enum": ["unsupported", "refused_ceiling", "scored"] },
    "n": { "type": "integer", "minimum": 100 },
    "seed": { "type": "integer", "minimum": 0 },
    "model_id": { "type": "string" },
    "model_revision": { "type": "string" },
    "device": { "const": "cuda" },
    "backend": { "enum": ["manual-peft", "trl-peft"] },
    "before": { "$ref": "#/$defs/eval_slice" },
    "after": { "$ref": "#/$defs/eval_slice" },
    "paired_ci": { "$ref": "#/$defs/delta_ci" },
    "cluster_ci": { "$ref": "#/$defs/delta_ci" },
    "leave_one_filing_out": {
      "type": "array",
      "items": { "$ref": "#/$defs/lofo_row" }
    },
    "format_breakdown": { "$ref": "#/$defs/format_breakdown" },
    "jpm_sensitivity": { "$ref": "#/$defs/jpm_sensitivity" },
    "stored_hit_mismatches": { "type": "integer", "minimum": 0 },
    "uplift": { "type": "string" },
    "verdict_detail": { "type": "string" },
    "train_proof": { "type": "object", "additionalProperties": true },
    "hardware": { "type": "object", "additionalProperties": true },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "detail"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "adapter_written": { "type": "boolean" },
    "bf16": { "const": "unsupported" },
    "ddp": { "type": "string" }
  },
  "$defs": {
    "eval_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_name", "task_score", "n"],
      "properties": {
        "metric_name": { "const": "exact_match" },
        "task_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "n": { "type": "integer", "minimum": 100 },
        "hits": { "type": "integer", "minimum": 0 }
      }
    },
    "delta_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_delta", "low", "high", "n", "rounds", "seed", "verdict"],
      "properties": {
        "mean_delta": { "type": "number" },
        "low": { "type": "number" },
        "high": { "type": "number" },
        "n": { "type": "integer", "minimum": 1 },
        "n_clusters": { "type": "integer", "minimum": 1 },
        "rounds": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "verdict": { "type": "string" },
        "grouping": { "type": "string" }
      }
    },
    "lofo_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_out", "n", "mean_delta"],
      "properties": {
        "left_out": { "type": "string" },
        "n": { "type": "integer", "minimum": 0 },
        "mean_delta": { "type": ["number", "null"] }
      }
    },
    "format_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format_gains",
        "substantive_gains",
        "losses",
        "net_substantive",
        "format_ci",
        "substantive_ci"
      ],
      "properties": {
        "format_gains": { "type": "integer", "minimum": 0 },
        "substantive_gains": { "type": "integer", "minimum": 0 },
        "losses": { "type": "integer", "minimum": 0 },
        "net_substantive": { "type": "integer" },
        "format_ci": { "$ref": "#/$defs/delta_ci" },
        "substantive_ci": { "$ref": "#/$defs/delta_ci" }
      }
    },
    "jpm_sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excluded_family",
        "excluded_n",
        "n",
        "before_hits",
        "after_hits",
        "item_ci",
        "cluster_ci"
      ],
      "properties": {
        "excluded_family": { "type": "string" },
        "excluded_n": { "type": "integer", "minimum": 0 },
        "n": { "type": "integer", "minimum": 0 },
        "before_hits": { "type": "integer", "minimum": 0 },
        "after_hits": { "type": "integer", "minimum": 0 },
        "item_ci": { "$ref": "#/$defs/delta_ci" },
        "cluster_ci": { "$ref": "#/$defs/delta_ci" }
      }
    }
  }
}
