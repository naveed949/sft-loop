{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naveed949/sft-loop/schema/run_report.schema.json",
  "title": "sft-loop run report",
  "description": "Schema-locked report for the pinned <=3B SFT loop. The scored path is TRL + PEFT LoRA on MPS (device mps, backend trl-peft, stack.unsloth unused). Unsloth is optional and CUDA-only (device cuda, backend unsloth). status unsupported means train did not run. status unscored means no task scores are present. status scored means before and after task scores share one seed and train_proof is present, so weight_change_claimed is true. weight_change_claimed is false on unsupported and unscored reports. A task score is not a safety judgment (metric_role is task_score_not_safety). No qualification field is defined. additionalProperties is false on every object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model_id",
    "stack",
    "status",
    "metric_role",
    "weight_change_claimed"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "model_id": {
      "const": "Qwen/Qwen2.5-1.5B-Instruct"
    },
    "stack": {
      "$ref": "#/$defs/stack"
    },
    "device": {
      "type": "string",
      "enum": ["mps", "cuda"],
      "description": "Device that ran the scored train. mps is the TRL + PEFT path. cuda is the optional Unsloth path. Absent unless status is scored."
    },
    "backend": {
      "type": "string",
      "enum": ["trl-peft", "unsloth"],
      "description": "trl-peft does not use Unsloth. unsloth is CUDA-only."
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["unsupported", "unscored", "scored"]
    },
    "metric_role": {
      "const": "task_score_not_safety"
    },
    "weight_change_claimed": {
      "type": "boolean"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "before": {
      "$ref": "#/$defs/eval_slice"
    },
    "after": {
      "$ref": "#/$defs/eval_slice"
    },
    "train_proof": {
      "$ref": "#/$defs/train_proof"
    },
    "unsupported": {
      "$ref": "#/$defs/unsupported"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "unsupported" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["unsupported"],
        "properties": {
          "before": false,
          "after": false,
          "train_proof": false,
          "weight_change_claimed": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "unscored" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "before": false,
          "after": false,
          "unsupported": false,
          "train_proof": false,
          "weight_change_claimed": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "scored" }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["seed", "task_id", "before", "after", "train_proof"],
        "properties": {
          "unsupported": false,
          "weight_change_claimed": { "const": true }
        },
        "description": "before.seed and after.seed must equal seed. weight_change_claimed is true only together with train_proof of a finished PEFT step."
      }
    },
    {
      "if": {
        "properties": {
          "weight_change_claimed": { "const": false }
        },
        "required": ["weight_change_claimed"]
      },
      "then": {
        "properties": {
          "train_proof": false,
          "status": { "enum": ["unsupported", "unscored"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "weight_change_claimed": { "const": true }
        },
        "required": ["weight_change_claimed"]
      },
      "then": {
        "required": ["train_proof", "seed", "task_id", "before", "after"],
        "properties": {
          "status": { "const": "scored" },
          "unsupported": false
        }
      }
    },
    {
      "if": {
        "required": ["device"]
      },
      "then": {
        "required": ["backend", "status"],
        "properties": {
          "status": { "const": "scored" }
        },
        "description": "device is labeled only on a scored report. An unsupported report must not claim mps or cuda."
      }
    },
    {
      "if": {
        "properties": {
          "device": { "const": "mps" }
        },
        "required": ["device"]
      },
      "then": {
        "required": ["backend"],
        "properties": {
          "backend": { "const": "trl-peft" },
          "stack": {
            "properties": {
              "unsloth": { "const": "unused" }
            }
          }
        },
        "description": "MPS scored reports use TRL + PEFT and do not claim Unsloth."
      }
    },
    {
      "if": {
        "properties": {
          "backend": { "const": "trl-peft" }
        },
        "required": ["backend"]
      },
      "then": {
        "required": ["device"],
        "properties": {
          "device": { "const": "mps" },
          "stack": {
            "properties": {
              "unsloth": { "const": "unused" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": { "const": "cuda" }
        },
        "required": ["device"]
      },
      "then": {
        "required": ["backend"],
        "properties": {
          "backend": { "const": "unsloth" },
          "stack": {
            "properties": {
              "unsloth": { "const": "2026.9.12" }
            }
          }
        },
        "description": "CUDA device label is the optional Unsloth backend."
      }
    },
    {
      "if": {
        "properties": {
          "backend": { "const": "unsloth" }
        },
        "required": ["backend"]
      },
      "then": {
        "required": ["device"],
        "properties": {
          "device": { "const": "cuda" },
          "stack": {
            "properties": {
              "unsloth": { "const": "2026.9.12" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsloth", "trl", "method"],
      "properties": {
        "unsloth": {
          "enum": ["2026.9.12", "unused"],
          "description": "2026.9.12 is the optional CUDA pin. unused means that package was not the train backend."
        },
        "trl": { "const": "0.24.0" },
        "method": { "const": "sft-lora" }
      }
    },
    "eval_slice": {
      "type": "object",
      "additionalProperties": false,
      "description": "One eval split. task_score is a task metric in [0, 1]. It is not a safety judgment. Same seed is required on before and after when status is scored.",
      "required": ["seed", "metric_name", "task_score", "n"],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "metric_name": {
          "const": "exact_match"
        },
        "task_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "train_proof": {
      "type": "object",
      "additionalProperties": false,
      "description": "Evidence that a TRL SFTTrainer PEFT step finished. Hashes must match runs/phase3/proof/adapter_config.json and runs/phase3/proof/train_log.txt.",
      "required": [
        "trainer",
        "global_step",
        "train_loss",
        "lora_r",
        "max_steps",
        "adapter_config_sha256",
        "train_log_sha256",
        "adapter_config_path",
        "train_log_path"
      ],
      "properties": {
        "trainer": { "const": "trl.SFTTrainer" },
        "global_step": { "type": "integer", "minimum": 1 },
        "train_loss": { "type": "number" },
        "lora_r": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 20 },
        "adapter_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "train_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "adapter_config_path": { "const": "adapter_config.json" },
        "train_log_path": { "const": "train_log.txt" }
      }
    },
    "unsupported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "detail"],
      "properties": {
        "reason": {
          "type": "string",
          "enum": ["gpu_or_train_deps_unavailable", "train_not_run"]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
